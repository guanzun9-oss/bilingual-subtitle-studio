{
  "name": "bilingual-subtitle-studio",
  "version": "0.4.0",
  "description": "Turn Buzz English SRT files into naturally segmented, time-aligned bilingual subtitles.",
  "private": true,
  "homepage": "https://bilingual-subtitle-studio.guanzun9-tools.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guanzun9-oss/bilingual-subtitle-studio.git"
  },
  "bugs": {
    "url": "https://github.com/guanzun9-oss/bilingual-subtitle-studio/issues"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/srt-core.test.mjs tests/subtitle-profiles.test.mjs tests/source-api.test.mjs tests/source-ui.test.mjs tests/workflow-tooling.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:quick": "npm run lint && npm run typecheck && npm run test:unit",
    "check": "npm run lint && npm run typecheck && npm test && npm run audit:production",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "setup:git": "node scripts/setup-git.mjs",
    "release:check": "node scripts/release-notes.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  },
  "type": "module",
  "overrides": {
    "vinext": {
      "image-size": "2.0.4"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
